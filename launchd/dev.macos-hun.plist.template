<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.macos-hun</string>
  <key>ProgramArguments</key><array>
    <string>__HUN_BIN__</string>
    <string>check</string>
  </array>
  <key>StartInterval</key><integer>__INTERVAL__</integer>
  <key>RunAtLoad</key><false/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>__HUN_LOGS__/hun.out.log</string>
  <key>StandardErrorPath</key><string>__HUN_LOGS__/hun.err.log</string>
</dict>
</plist>
